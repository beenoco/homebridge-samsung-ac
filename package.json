{
  "name": "@beenoco/homebridge-samsung-ac",
  "displayName": "Beenoco Samsung AC",
  "type": "module",
  "version": "0.2.2",
  "private": false,
  "description": "Samsung air conditioner plugin for Homebridge by Beenoco.",
  "author": "Beenoco",
  "license": "Apache-2.0",
  "homepage": "https://github.com/beenoco/homebridge-samsung-ac#readme",
  "repository": {
    "type": "git",
